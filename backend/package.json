{
    "name": "backend-ts",
    "version": "1.0.0",
    "main": "index.js",
    "scripts": {
        "exec": "ts-node  -r dotenv/config index.ts",
        "dev": "nodemon",
        "seed": "ts-node  db/seed.ts",
        "migrate": "rm  ping.db; ts-node  db/seed.ts",
        "test": "sh test.sh",
        "test:migrate": "rm  /tmp/test.db; DB_PATH=/tmp/test.db ts-node  db/seed.ts",
        "test:debug": "DB_PATH=/tmp/test.db NODE_ENV=test node --inspect-brk=0.0.0.0:9229 -r dotenv/config ./node_modules/.bin/jest --runInBand --no-cache"
    },
    "_moduleAliases": {
        "@root": ".",
        "@db": "./db"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@faker-js/faker": "^9.8.0",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.0.1",
        "@fastify/jwt": "^9.1.0",
        "@fastify/multipart": "^9.0.3",
        "@fastify/oauth2": "^8.1.2",
        "@fastify/session": "^11.1.0",
        "@fastify/static": "^8.2.0",
        "@fastify/websocket": "^11.0.2",
        "bcrypt": "^6.0.0",
        "fastify": "^5.3.3",
        "fastify-type-provider-zod": "^5.0.1",
        "module-alias": "^2.2.3",
        "pino-pretty": "^7.0.0",
        "resend": "^6.0.1",
        "sqlite3": "^5.1.7",
        "zod": "^3.25.74"
    },
    "devDependencies": {
        "@types/bcrypt": "^5.0.2",
        "@types/jest": "^30.0.0",
        "@types/node": "^22.15.18",
        "@types/nodemailer": "^7.0.0",
        "@types/supertest": "^6.0.3",
        "@types/ws": "^8.18.1",
        "dotenv": "^16.5.0",
        "jest": "^30.0.4",
        "nodemon": "^3.1.10",
        "supertest": "^7.1.1",
        "ts-jest": "^29.4.0",
        "ts-node": "^10.9.2",
        "typescript": "^5.8.3"
    }
