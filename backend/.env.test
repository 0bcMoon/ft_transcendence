# Test environment variables
# This file is loaded during testing and can override values from .env

# Use a test database
DB_PATH=/tmp/test.db

# Test environment
NODE_ENV=test

# Use the same JWT secret for consistent testing
JWT_SECRET=439ecfcaa44bfcc982fd9436f2ddba049157bcc578357a6dde8b171d82b28afd

# Test cookie domain
COOKIE_DOMAIN=localhost

# Test frontend URL
FRONTEND_URL=http://localhost:5173

# Shorter token expiration for testing
ACCESS_TOKEN_EXPR=300s
REFRESH_TOEKN_EXPR=604800s
