#!/bin/bash
set -xe
set -o pipefail


tmux new-session -d -s dev -n "backend"
tmux send-keys -t dev:1 "cd backend" C-m
tmux send-keys -t dev:1 "nvim" C-m

# Backend server
tmux new-window -t dev:2 -n "backend-server"
tmux send-keys -t dev:2 "cd backend" C-m
tmux send-keys -t dev:2 "npm run dev" C-m

# Frontend editing
tmux new-window -t dev:3 -n "frontend"
tmux send-keys -t dev:3 "cd frontend" C-m
tmux send-keys -t dev:3 "nvim" C-m

# Frontend server
tmux new-window -t dev:4 -n "frontend-server"
tmux send-keys -t dev:4 "cd frontend" C-m
tmux send-keys -t dev:4 "npm run dev" C-m

# Attach to the session
tmux attach-session -t dev

